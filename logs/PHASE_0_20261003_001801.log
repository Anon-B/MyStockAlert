COMMAND: docker-compose config
name: mystockalert
services:
  backend:
    build:
      context: /Users/anonpond/MyStockAlert/backend
      dockerfile: Dockerfile
    depends_on:
      postgres:
        condition: service_healthy
        required: true
    environment:
      APP_SECRET: change-me
      DATABASE_URL: postgresql://mystockalert:change-me@postgres:5432/mystockalert
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8000
        published: "8000"
        protocol: tcp
  frontend:
    build:
      context: /Users/anonpond/MyStockAlert/frontend
      dockerfile: Dockerfile
    depends_on:
      backend:
        condition: service_started
        required: true
    environment:
      NEXT_PUBLIC_API_URL: http://localhost:8000
    networks:
      default: null
    ports:
      - mode: ingress
        target: 3000
        published: "3000"
        protocol: tcp
  postgres:
    environment:
      POSTGRES_DB: mystockalert
      POSTGRES_PASSWORD: change-me
      POSTGRES_USER: mystockalert
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U mystockalert -d mystockalert
      timeout: 5s
      interval: 5s
      retries: 10
    image: postgres:17-alpine
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: volume
        source: postgres_data
        target: /var/lib/postgresql/data
        volume: {}
      - type: bind
        source: /Users/anonpond/MyStockAlert/database/init.sql
        target: /docker-entrypoint-initdb.d/001_init.sql
        read_only: true
        bind: {}
  worker:
    build:
      context: /Users/anonpond/MyStockAlert/worker
      dockerfile: Dockerfile
    depends_on:
      postgres:
        condition: service_healthy
        required: true
    environment:
      DATABASE_URL: postgresql://mystockalert:change-me@postgres:5432/mystockalert
    networks:
      default: null
networks:
  default:
    name: mystockalert_default
volumes:
  postgres_data:
    name: mystockalert_postgres_data
